# ============================================================
# Multi-Agent AI Customer Support Assistant — Environment Config
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ============================================================

# ---- Google Gemini -----------------------------------------
# Obtain from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# ---- Database (Supabase PostgreSQL) ------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=

# ---- JWT Authentication ------------------------------------
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Embeddings --------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- FAISS Vector Store ------------------------------------
FAISS_INDEX_PATH=./vectorstore/faiss_index.bin
FAISS_METADATA_PATH=./vectorstore/faiss_metadata.json

# ---- CORS --------------------------------------------------
# The URL of the running frontend (local dev or production)
FRONTEND_URL=http://localhost:3000
